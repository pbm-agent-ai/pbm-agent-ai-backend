# AI Services
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Naver Shopping API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# Naver 모킹 모드 (true=고정 데이터 반환, false=실제 Naver API 호출)
# 기본값은 false이며, 필요 시 true로 설정하여 모킹 모드를 활성화할 수 있다.
NAVER_MOCK_ENABLED=false

# AliExpress Affiliate API
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""

# AliExpress 모킹 모드 (true=고정 데이터 반환, false=실제 AliExpress API 호출)
# 기본값은 false이며, 필요 시 true로 설정하여 모킹 모드를 활성화할 수 있다.
ALIEXPRESS_MOCK_ENABLED=false

# 공공데이터 API
EXCHANGE_RATE_API_KEY=""
CONSUMER_PRICE_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Gmail SMTP
GMAIL_APP_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# Database
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=password

COMMAND_DB_URL=jdbc:postgresql://localhost:5432/command_db
COMMAND_DB_USERNAME=postgres
COMMAND_DB_PASSWORD=password

PRICE_DB_URL=jdbc:postgresql://localhost:5432/price_db
PRICE_DB_USERNAME=postgres
PRICE_DB_PASSWORD=password

PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=password

NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Blockchain
SEPOLIA_RPC_URL=
WALLET_PRIVATE_KEY=

