# 네이버 API 자격증명 (절대 실제 키를 하드코딩하지 마세요)
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# 모킹 모드 (true로 설정하면 Naver API 자격증명 없이도 고정 데이터 반환)
# 기본값은 false이며, 실제 API를 호출합니다. 필요 시 true로 설정하여 모킹 모드를 활성화할 수 있습니다.
NAVER_MOCK_ENABLED=false

# AliExpress Affiliate API 자격증명 (절대 실제 키를 하드코딩하지 마세요)
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here

# AliExpress API 기본 URL (기본값: https://api-sg.aliexpress.com/sync)
ALIEXPRESS_BASE_URL=https://api-sg.aliexpress.com/sync

# AliExpress 모킹 모드 (true로 설정하면 AliExpress API 자격증명 없이도 고정 데이터 반환)
# 기본값은 false이며, 실제 API를 호출합니다. 필요 시 true로 설정하여 모킹 모드를 활성화할 수 있습니다.
ALIEXPRESS_MOCK_ENABLED=false